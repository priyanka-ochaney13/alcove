<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".UserProfileActivity"
    tools:ignore="MissingDefaultResource">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:src="@drawable/ic_back"
        android:contentDescription="Back"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- ScrollView for content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- Profile Image -->
            <ImageView
                android:id="@+id/profileImage"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_profile"
                android:scaleType="centerCrop"
                android:background="@drawable/rounded_input_background"
                android:clipToOutline="true"
                android:layout_marginBottom="16dp" />

            <!-- Change Profile Picture Button -->
            <Button
                android:id="@+id/changeProfilePicBtn"
                style="@style/AppButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Change Picture"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- User Name -->
            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/on_surface"
                android:layout_marginBottom="8dp" />

            <!-- User Email -->
            <TextView
                android:id="@+id/userEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="john@example.com"
                android:textSize="14sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="8dp" />

            <!-- User Bio -->
            <TextView
                android:id="@+id/userBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book lover and avid reader. Always looking for the next great story!"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- User Location -->
            <TextView
                android:id="@+id/userLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location not enabled"
                android:textSize="13sp"
                android:textColor="@color/on_surface_variant"
                android:visibility="visible"
                android:layout_marginBottom="32dp" />



            <!-- Edit Profile Button -->
            <Button
                android:id="@+id/editProfileBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Edit Profile"
                android:textColor="@color/primary"
                android:backgroundTint="@color/primary"
                android:layout_marginBottom="12dp" />

            <!-- Enable Location Button -->
            <Button
                android:id="@+id/enableLocationBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Enable Location"
                android:textColor="@color/primary"
                android:backgroundTint="@color/primary"
                android:layout_marginBottom="12dp" />

            <!-- My Reviews Button -->
            <Button
                android:id="@+id/myReviewsBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="My Reviews"
                android:layout_marginBottom="12dp" />

            <!-- Preferences Button -->
            <Button
                android:id="@+id/preferencesBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Preferences"
                android:layout_marginBottom="12dp" />

            <!-- Reading Statistics Button -->
            <Button
                android:id="@+id/readingStatsBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Reading Statistics"
                android:layout_marginBottom="12dp" />

            <!-- Settings Button -->
            <Button
                android:id="@+id/settingsBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Settings"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/submitBookBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Submit a Book"
                android:visibility="gone" />

            <!-- Logout Button -->
            <Button
                android:id="@+id/logoutBtn"
                style="@style/AppButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Logout"
                android:textColor="@color/error"
                android:backgroundTint="@android:color/transparent" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
